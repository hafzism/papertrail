# Browser-visible values are intentionally limited to public Supabase configuration.
APP_ORIGIN=http://localhost:3000
REFERENCE_PORTAL_ORIGIN=http://localhost:3001
ALLOWED_AUTH_REDIRECTS=http://localhost:3000/auth/callback
NEXT_PUBLIC_SUPABASE_URL=
# Prefer the current publishable key. The legacy anon key remains supported during setup.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Trusted server/worker values. Never expose or commit real values.
SUPABASE_SERVICE_ROLE_KEY=
# Use the Supabase Connect-panel Session Pooler URL, not the IPv6-only direct host, on networks without IPv6.
DATABASE_URL=
OPENAI_API_KEY=
OPENAI_PROJECT_ID=
MODEL_SMALL=
MODEL_MAIN=
MODEL_REVIEW=
MODEL_LIVE=
MODEL_TRANSCRIBE=
ALLOW_FRONTIER_ESCALATION=false
OPENAI_CAMPAIGN_BUDGET_USD=5
RATE_CARD_PATH=docs/setup/rate-card.json

# Telegram is required for W7. Leave blank until the bot is configured.
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_BOT_USERNAME=

# Browser provider defaults to the local, isolated runner.
BROWSER_PROVIDER=local
BROWSER_GATEWAY_INTERNAL_URL=http://browser-gateway:3002
BROWSER_GATEWAY_SECRET=
# Exact comma-separated portal origins. Never use a wildcard or arbitrary destination.
BROWSER_ALLOWED_ORIGINS=
# Browser-visible HTTPS gateway origin for short-lived noVNC takeover tickets.
BROWSER_GATEWAY_PUBLIC_ORIGIN=http://localhost:3002
BROWSER_GATEWAY_PORT=3002
BROWSER_MAX_SESSION_MINUTES=20
BROWSER_IDLE_MINUTES=3
BROWSERBASE_API_KEY=
BROWSERBASE_PROJECT_ID=
APP_LINK_SIGNING_KEY=
INTERNAL_JOB_SECRET=
WORKER_ID=
# Optional local OCR for scanned PDFs. Install Tesseract and language data before enabling.
OCR_LANGUAGES=eng
# Set only matching, tested handlers. The worker refuses to claim other job kinds.
# Enable only matching, configured handlers. Telegram delivery also requires a linked
# chat plus bot credentials: extract_document,capture_public_source,deliver_telegram_notification
WORKER_ENABLED_KINDS=

DEMO_MODE=true
DEMO_RESET_SECRET=
SOURCE_CHECK_INTERVAL_MINUTES=60
SOURCE_MAX_ACTIVE=20
BROWSER_MAX_CONCURRENT=1
